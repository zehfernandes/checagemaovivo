# Provider for transcription + fact-checking: "openai" or "mock"
PROVIDER=mock
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (e.g. Vercel AI Gateway); empty = api.openai.com
OPENAI_BASE_URL=
# Models (OpenAI)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
FACTCHECK_MODEL=gpt-4.1-mini
# Audio chunk size in seconds (smaller = lower latency, more API calls)
CHUNK_SECONDS=8
# Default spoken language hint for transcription (ISO-639-1), empty = auto
LANGUAGE=pt
# Comma-separated origins allowed to hit the API (dev default below)
CORS_ORIGINS=http://localhost:5173
