# Provider for transcription + fact-checking: "openai" or "mock"
PROVIDER=mock
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (e.g. Vercel AI Gateway); empty = api.openai.com
OPENAI_BASE_URL=
# Models (OpenAI)
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
FACTCHECK_MODEL=gpt-4.1-mini
# Audio chunk size in seconds (smaller = lower latency, more API calls)
CHUNK_SECONDS=8
# Default spoken language hint for transcription (ISO-639-1), empty = auto
LANGUAGE=pt
# Comma-separated origins allowed to hit the API (dev default below)
CORS_ORIGINS=http://localhost:5173
# News/evidence database (first-level lookup; web search is the fallback)
NEWS_DB_PATH=data/news.db
EMBEDDING_MODEL=text-embedding-3-small
# Minimum cosine similarity for a DB hit to be used as evidence (0-1)
NEWS_MIN_SIMILARITY=0.55
# Only ingest feed items newer than this many days
NEWS_MAX_AGE_DAYS=14
# Background feed refresh interval (minutes); 0 disables
NEWS_REFRESH_MINUTES=30
# Optional feed override: "Name=https://feed,Name2=https://feed2" (empty = built-in Brazilian list)
NEWS_FEEDS=
